@inherits LayoutComponentBase

<div class="page">
    <div class="sidebar">
        <NavMenu />
    </div>

    <main class="d-flex flex-column min-vh-100">
        <div class="top-row px-4 border-bottom bg-white d-flex align-items-center justify-content-between">
            <div class="fw-bold text-navy">
                Registro Civil Digital — Sistema de Gestión
            </div>
            <span class="badge bg-secondary opacity-75">Versión 1.0</span>
        </div>

        <article class="content px-4 py-3 flex-grow-1">
            @Body
        </article>
    </main>
</div>

<div id="blazor-error-ui">
    Ha ocurrido un error no controlado.
    <a href="" class="reload">Recargar</a>
    <a class="dismiss">🗙</a>
</div>