@inherits LayoutComponentBase

<div class="page">
    <div class="sidebar">
        <NavMenu />
    </div>

    <main class="d-flex flex-column min-vh-100">
        <!-- Cabecera Institucional -->
        <div class="top-row px-4 border-bottom bg-white d-flex align-items-center justify-content-between">
            <div class="fw-bold text-navy">
                <i class="bi bi-shield-lock me-2 text-primary"></i> Registro Civil Digital — Sistema de Gestión
            </div>
            <span class="badge bg-success bg-opacity-10 text-success border border-success border-opacity-25 px-2 py-1 small">
                <i class="bi bi-circle-fill me-1" style="font-size: 0.5rem;"></i> Sistema Operativo
            </span>
        </div>

        <!-- Contenido Principal -->
        <article class="content px-4 py-3 flex-grow-1">
            @Body
        </article>

        <!-- Pie de Página Institucional -->
        <footer class="bg-white border-top py-3 px-4 text-center text-md-start d-flex flex-column flex-md-row justify-content-between align-items-center text-muted small mt-auto">
            <div>
                © 2026 <strong>Sistema de Registro Civil Digital</strong> — República del Perú
            </div>
            <div class="mt-1 mt-md-0 opacity-75">
                <span>Blazor Server | SQL Server 2019</span>
            </div>
        </footer>
    </main>
</div>