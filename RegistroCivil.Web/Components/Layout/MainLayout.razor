@inherits LayoutComponentBase

<div class="page">
    <div class="sidebar">
        <NavMenu />
    </div>

    <main class="d-flex flex-column min-vh-100">
        <div class="top-row px-4">
            <div class="topbar-context">
                <span>Sistema institucional</span>
                <strong>Panel de gestión</strong>
            </div>
            <span class="version-badge">Versión 1.0</span>
        </div>

        <article class="content flex-grow-1">
            @Body
        </article>
    </main>
</div>

<div id="blazor-error-ui">
    Ha ocurrido un error no controlado.
    <a href="" class="reload">Recargar</a>
    <a class="dismiss">🗙</a>
</div>
