@page "/actas/editar/{NumeroActa}"
@using Microsoft.Data.SqlClient
@using RegistroCivil.Web.Models
@using RegistroCivil.Web.Services
@inject ActaNacimientoService ActaService

<PageTitle>Editar acta</PageTitle>
<OrigenDatos Archivo="@EsArchivo" />

<div class="page-heading">
    <span class="eyebrow">Actualización de registro</span>
    <h1>Editar acta</h1>
    <p>Revise la información y guarde únicamente los cambios necesarios.</p>
</div>

@if (cargando)
{
    <p>Cargando acta...</p>
}
else if (!string.IsNullOrWhiteSpace(mensajeCarga))
{
    <div class="alert alert-danger">@mensajeCarga</div>

    <a class="btn btn-secondary" href="@($"/actas{Sufijo}")">
        Volver a búsqueda
    </a>
}
else if (acta is not null)
{
    @if (!string.IsNullOrWhiteSpace(mensajeExito))
    {
        <div class="alert alert-success">@mensajeExito</div>
    }

    @if (!string.IsNullOrWhiteSpace(mensajeError))
    {
        <div class="alert alert-danger">@mensajeError</div>
    }

    <div class="card form-panel">
        <div class="card-body">
            <EditForm Model="@acta"
                      OnValidSubmit="@GuardarAsync"
                      FormName="editar-acta">

                <DataAnnotationsValidator />
                <ValidationSummary class="text-danger" />

                <div class="row g-3">
                    <div class="col-md-6">
                        <label class="form-label" for="campo-1">Número de acta</label>
                        <input id="campo-1" class="form-control"
                               value="@acta.NumeroActa"
                               readonly />
                        <div class="form-text">
                            El número del acta no puede modificarse.
                        </div>
                    </div>

                    <div class="col-md-6">
                        <label class="form-label" for="campo-2">DNI del inscrito</label>
                        <InputTextLive id="campo-2" class="form-control"
                                   maxlength="8"
                                   @bind-Value="acta.DniInscrito" />
                        <ValidationMessage For="@(() => acta.DniInscrito)" />
                    </div>

                    <div class="col-md-6">
                        <label class="form-label" for="campo-3">Apellido paterno</label>
                        <InputTextLive id="campo-3" class="form-control"
                                   @bind-Value="acta.ApellidoPaterno" />
                        <ValidationMessage For="@(() => acta.ApellidoPaterno)" />
                    </div>

                    <div class="col-md-6">
                        <label class="form-label" for="campo-4">Apellido materno</label>
                        <InputTextLive id="campo-4" class="form-control"
                                   @bind-Value="acta.ApellidoMaterno" />
                        <ValidationMessage For="@(() => acta.ApellidoMaterno)" />
                    </div>

                    <div class="col-md-12">
                        <label class="form-label" for="campo-5">Nombres</label>
                        <InputTextLive id="campo-5" class="form-control"
                                   @bind-Value="acta.Nombres" />
                        <ValidationMessage For="@(() => acta.Nombres)" />
                    </div>

                    <div class="col-md-4">
                        <label class="form-label" for="campo-6">
                            Fecha de nacimiento
                        </label>
                        <InputDateLive id="campo-6" class="form-control"
                                   @bind-Value="acta.FechaNacimiento" />
                    </div>

                    <div class="col-md-4">
                        <label class="form-label" for="campo-7">Sexo</label>
                        <InputSelect id="campo-7" class="form-select"
                                     @bind-Value="acta.Sexo">
                            <option value="">Seleccione</option>
                            <option value="F">Femenino</option>
                            <option value="M">Masculino</option>
                        </InputSelect>
                        <ValidationMessage For="@(() => acta.Sexo)" />
                    </div>

                    <div class="col-md-4">
                        <label class="form-label" for="campo-8">
                            Ubigeo de nacimiento
                        </label>
                        <InputTextLive id="campo-8" class="form-control"
                                   maxlength="6"
                                   @bind-Value="acta.UbigeoNacimiento" />
                        <ValidationMessage For="@(() => acta.UbigeoNacimiento)" />
                    </div>

                    <div class="col-md-12">
                        <label class="form-label" for="campo-9">
                            Lugar de nacimiento
                        </label>
                        <InputTextLive id="campo-9" class="form-control"
                                   @bind-Value="acta.LugarNacimiento" />
                        <ValidationMessage For="@(() => acta.LugarNacimiento)" />
                    </div>

                    <div class="col-12 form-actions mt-4">
                        <button type="submit"
                                class="btn btn-primary"
                                disabled="@procesando">
                            @(procesando
                                ? "Guardando..."
                                : "Guardar cambios")
                        </button>

                        <a class="btn btn-outline-secondary"
                           href="@($"/actas{Sufijo}")">
                            Cancelar
                        </a>
                    </div>
                </div>
            </EditForm>
        </div>
    </div>
}

@code {
    [SupplyParameterFromQuery(Name = "origen")] public string? Origen { get; set; }
    private bool EsArchivo => Origen == "archivo";
    private string Sufijo => EsArchivo ? "?origen=archivo" : "";
    [Parameter]
    public string NumeroActa { get; set; } = string.Empty;

    private ActaNacimiento? acta;
    private bool cargando = true;
    private bool procesando;
    private string? mensajeCarga;
    private string? mensajeExito;
    private string? mensajeError;

    protected override async Task OnParametersSetAsync()
    {
        cargando = true;
        mensajeCarga = null;

        try
        {
            acta = await ActaService.BuscarPorNumeroAsync(NumeroActa, EsArchivo);

            if (acta is null)
            {
                mensajeCarga = "El acta solicitada no existe.";
            }
            else if (acta.Estado == 0)
            {
                mensajeCarga = "Esta acta está anulada y no puede editarse.";
            }
        }
        catch (Exception ex)
        {
            mensajeCarga =
                $"No se pudo cargar el acta: {ex.Message}";
        }
        finally
        {
            cargando = false;
        }
    }

    private async Task GuardarAsync()
    {
        if (acta is null)
        {
            return;
        }

        mensajeExito = null;
        mensajeError = null;

        if (acta.FechaNacimiento >
            DateOnly.FromDateTime(DateTime.Today))
        {
            mensajeError =
                "La fecha de nacimiento no puede ser futura.";
            return;
        }

        procesando = true;

        try
        {
            var actualizado =
                await ActaService.ModificarAsync(acta, EsArchivo);

            mensajeExito = actualizado
                ? "El acta fue modificada correctamente."
                : "No se encontró el acta que se intentó modificar.";
        }
        catch (SqlException ex) when (ex.Number is 2601 or 2627)
        {
            mensajeError =
                "El DNI ya está asociado a otra acta de nacimiento.";
        }
        catch (Exception ex)
        {
            mensajeError =
                $"No se pudo modificar el acta: {ex.Message}";
        }
        finally
        {
            procesando = false;
        }
    }
}
