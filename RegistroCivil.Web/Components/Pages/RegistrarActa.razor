@page "/actas/registrar"
@using Microsoft.Data.SqlClient
@using RegistroCivil.Web.Models
@using RegistroCivil.Web.Services
@inject ActaNacimientoService ActaService

<PageTitle>Registrar acta</PageTitle>
<OrigenDatos Archivo="@EsArchivo" />

<div class="page-heading">
    <span class="eyebrow">Nueva inscripción</span>
    <h1>Registrar acta</h1>
    <p>Complete la información del inscrito. Los datos serán validados antes de guardarse.</p>
</div>

@if (!string.IsNullOrWhiteSpace(mensajeExito))
{
    <div class="alert alert-success">
        @mensajeExito
    </div>
}

@if (!string.IsNullOrWhiteSpace(mensajeError))
{
    <div class="alert alert-danger">
        @mensajeError
    </div>
}

<div class="card form-panel">
    <div class="card-body">
        <EditForm Model="@acta"
                  OnValidSubmit="@RegistrarAsync"
                  FormName="registrar-acta">

            <DataAnnotationsValidator />
            <ValidationSummary class="text-danger" />

            <div class="row g-3">
                <div class="col-md-6">
                    <label class="form-label" for="campo-1">Número de acta</label>
                    <InputTextLive id="campo-1" class="form-control"
                               @bind-Value="acta.NumeroActa" />
                    <ValidationMessage For="@(() => acta.NumeroActa)" />
                </div>

                <div class="col-md-6">
                    <label class="form-label" for="campo-2">DNI del inscrito</label>
                    <InputTextLive id="campo-2" class="form-control"
                               maxlength="8"
                               @bind-Value="acta.DniInscrito" />
                    <ValidationMessage For="@(() => acta.DniInscrito)" />
                </div>

                <div class="col-md-6">
                    <label class="form-label" for="campo-3">Apellido paterno</label>
                    <InputTextLive id="campo-3" class="form-control"
                               @bind-Value="acta.ApellidoPaterno" />
                    <ValidationMessage For="@(() => acta.ApellidoPaterno)" />
                </div>

                <div class="col-md-6">
                    <label class="form-label" for="campo-4">Apellido materno</label>
                    <InputTextLive id="campo-4" class="form-control"
                               @bind-Value="acta.ApellidoMaterno" />
                    <ValidationMessage For="@(() => acta.ApellidoMaterno)" />
                </div>

                <div class="col-md-12">
                    <label class="form-label" for="campo-5">Nombres</label>
                    <InputTextLive id="campo-5" class="form-control"
                               @bind-Value="acta.Nombres" />
                    <ValidationMessage For="@(() => acta.Nombres)" />
                </div>

                <div class="col-md-4">
                    <label class="form-label" for="campo-6">
                        Fecha de nacimiento
                    </label>
                    <InputDateLive id="campo-6" class="form-control"
                               @bind-Value="acta.FechaNacimiento" />
                    <ValidationMessage For="@(() => acta.FechaNacimiento)" />
                </div>

                <div class="col-md-4">
                    <label class="form-label" for="campo-7">Sexo</label>
                    <InputSelect id="campo-7" class="form-select"
                                 @bind-Value="acta.Sexo">
                        <option value="">Seleccione</option>
                        <option value="F">Femenino</option>
                        <option value="M">Masculino</option>
                    </InputSelect>
                    <ValidationMessage For="@(() => acta.Sexo)" />
                </div>

                <div class="col-md-4">
                    <label class="form-label" for="campo-8">
                        Ubigeo de nacimiento
                    </label>
                    <InputTextLive id="campo-8" class="form-control"
                               maxlength="6"
                               @bind-Value="acta.UbigeoNacimiento" />
                    <ValidationMessage For="@(() => acta.UbigeoNacimiento)" />
                </div>

                <div class="col-md-12">
                    <label class="form-label" for="campo-9">
                        Lugar de nacimiento
                    </label>
                    <InputTextLive id="campo-9" class="form-control"
                               @bind-Value="acta.LugarNacimiento" />
                    <ValidationMessage For="@(() => acta.LugarNacimiento)" />
                </div>

                <div class="col-12 form-actions mt-4">
                    <button type="submit"
                            class="btn btn-primary"
                            disabled="@procesando">
                        @(procesando ? "Registrando..." : "Registrar acta")
                    </button>

                    <a class="btn btn-outline-secondary" href="@($"/actas{Sufijo}")">
                        Cancelar
                    </a>
                </div>
            </div>
        </EditForm>
    </div>
</div>

@code {
    [SupplyParameterFromQuery(Name = "origen")] public string? Origen { get; set; }
    private bool EsArchivo => Origen == "archivo";
    private string Sufijo => EsArchivo ? "?origen=archivo" : "";
    private ActaNacimiento acta = NuevaActa();
    private bool procesando;
    private string? mensajeExito;
    private string? mensajeError;

    private async Task RegistrarAsync()
    {
        mensajeExito = null;
        mensajeError = null;

        if (acta.FechaNacimiento >
            DateOnly.FromDateTime(DateTime.Today))
        {
            mensajeError =
                "La fecha de nacimiento no puede ser futura.";
            return;
        }

        procesando = true;

        try
        {
            var id = await ActaService.RegistrarAsync(acta, EsArchivo);

            mensajeExito =
                $"Acta registrada correctamente con el identificador {id}.";

            acta = NuevaActa();
        }
        catch (SqlException ex) when (ex.Number is 2601 or 2627)
        {
            if (ex.Message.Contains(
                "IX_ActasNacimiento_DniInscrito",
                StringComparison.OrdinalIgnoreCase))
            {
                mensajeError =
                    "El DNI ya está asociado a otra acta de nacimiento.";
            }
            else
            {
                mensajeError =
                    "El número de acta ya está registrado.";
            }
        }
        catch (SqlException ex)
        {
            mensajeError =
                $"No se pudo registrar el acta: {ex.Message}";
        }
        catch (Exception ex)
        {
            mensajeError =
                $"Ocurrió un error inesperado: {ex.Message}";
        }
        finally
        {
            procesando = false;
        }
    }

    private static ActaNacimiento NuevaActa()
    {
        return new ActaNacimiento
        {
            FechaNacimiento =
                DateOnly.FromDateTime(DateTime.Today)
        };
    }
}
