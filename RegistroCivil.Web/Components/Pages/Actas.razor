@page "/actas"
@using System.Diagnostics
@using RegistroCivil.Web.Models
@using RegistroCivil.Web.Services
@inject ActaNacimientoService ActaService

<PageTitle>Búsqueda de actas</PageTitle>

<div class="page-heading">
    <span class="eyebrow">Consulta de registros</span>
    <h1>Búsqueda de actas</h1>
    <p>Localice un acta de nacimiento mediante uno de los criterios disponibles.</p>
</div>

<div class="card filter-panel mb-4">
    <div class="card-body">
        <h5 class="card-title">Criterios de búsqueda</h5>

        <div class="row g-3">
            <div class="col-md-5">
                <label class="form-label">Número de acta</label>
                <input class="form-control"
                       placeholder="Ejemplo: ACT-2026-000001"
                       @bind="numeroBuscado"
                       @bind:event="oninput" />
            </div>

            <div class="col-md-4">
                <label class="form-label">DNI del inscrito</label>
                <input class="form-control"
                       placeholder="8 dígitos"
                       maxlength="8"
                       @bind="dniBuscado"
                       @bind:event="oninput" />
            </div>

            <div class="col-md-3 d-flex align-items-end gap-2">
                <button type="button"
                        class="btn btn-primary"
                        disabled="@cargando"
                        @onclick="BuscarAsync">
                    Buscar
                </button>

                <button type="button"
                        class="btn btn-outline-secondary"
                        disabled="@cargando"
                        @onclick="LimpiarAsync">
                    Limpiar
                </button>
            </div>
        </div>
    </div>
</div>

@if (!string.IsNullOrWhiteSpace(mensajeError))
{
    <div class="alert alert-danger">@mensajeError</div>
}

@if (!string.IsNullOrWhiteSpace(mensajeInformativo))
{
    <div class="alert alert-info">@mensajeInformativo</div>
}

@if (cargando)
{
    <p>Cargando actas...</p>
}
else
{
    <div class="results-summary">
        <div>
            <span>Resultados</span>
            <strong>@actas.Count registros</strong>
        </div>

        @if (tiempoMilisegundos.HasValue)
        {
            <span class="badge bg-primary">
                Tiempo: @tiempoMilisegundos.Value.ToString("F2") ms
            </span>
        }
    </div>

    @if (actas.Count > 0)
    {
        <div class="table-responsive data-table-shell">
            <table class="table table-striped table-hover">
                <thead>
                    <tr>
                        <th>Número de acta</th>
                        <th>DNI</th>
                        <th>Apellidos y nombres</th>
                        <th>Fecha de nacimiento</th>
                        <th>Lugar</th>
                        <th>Estado</th>
                        <th>Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var acta in actas)
                    {
                        <tr>
                            <td>@acta.NumeroActa</td>
                            <td>@(acta.DniInscrito ?? "Sin DNI")</td>
                            <td>
                                @acta.ApellidoPaterno
                                @acta.ApellidoMaterno,
                                @acta.Nombres
                            </td>
                            <td>
                                @acta.FechaNacimiento.ToString("dd/MM/yyyy")
                            </td>
                            <td>@acta.LugarNacimiento</td>
                            <td>
                                @if (acta.Estado == 1)
                                {
                                    <span class="badge bg-success">
                                        Activa
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">
                                        Anulada
                                    </span>
                                }
                            </td>
                            <td class="text-nowrap">
                                @if (acta.Estado == 1)
                                {
                                    <a class="btn btn-sm btn-outline-primary me-1"
                                       href="@($"/actas/editar/{acta.NumeroActa}")">
                                        Editar
                                    </a>

                                    @if (idPendienteAnular == acta.Id)
                                    {
                                        <button class="btn btn-sm btn-danger me-1"
                                                @onclick="() => ConfirmarAnulacionAsync(acta.Id)">
                                            Confirmar
                                        </button>

                                        <button class="btn btn-sm btn-secondary"
                                                @onclick="CancelarAnulacion">
                                            Cancelar
                                        </button>
                                    }
                                    else
                                    {
                                        <button class="btn btn-sm btn-outline-danger"
                                                @onclick="() => SolicitarAnulacion(acta.Id)">
                                            Anular
                                        </button>
                                    }
                                }
                                else
                                {
                                    <span class="text-muted">Sin acciones</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
}

@code {
    private List<ActaNacimiento> actas = [];
    private string numeroBuscado = string.Empty;
    private string dniBuscado = string.Empty;
    private string? mensajeError;
    private string? mensajeInformativo;
    private double? tiempoMilisegundos;
    private bool cargando = true;
    private long? idPendienteAnular;

    protected override async Task OnInitializedAsync()
    {
        await CargarTodosAsync();
    }

    private async Task BuscarAsync()
    {
        mensajeError = null;
        mensajeInformativo = null;
        tiempoMilisegundos = null;
        actas = [];

        var numero = numeroBuscado.Trim();
        var dni = dniBuscado.Trim();

        if (string.IsNullOrWhiteSpace(numero) &&
            string.IsNullOrWhiteSpace(dni))
        {
            mensajeError =
                "Ingrese un número de acta o un DNI para buscar.";
            return;
        }

        if (!string.IsNullOrWhiteSpace(numero) &&
            !string.IsNullOrWhiteSpace(dni))
        {
            mensajeError =
                "Utilice solamente un criterio de búsqueda a la vez.";
            return;
        }

        if (!string.IsNullOrWhiteSpace(dni) &&
            (dni.Length != 8 || !dni.All(char.IsDigit)))
        {
            mensajeError = "El DNI debe contener exactamente 8 dígitos.";
            return;
        }

        cargando = true;
        var cronometro = Stopwatch.StartNew();

        try
        {
            if (!string.IsNullOrWhiteSpace(numero))
            {
                var acta =
                    await ActaService.BuscarPorNumeroAsync(numero);

                actas = acta is null ? [] : [acta];
            }
            else
            {
                actas = await ActaService.BuscarPorDniAsync(dni);
            }

            if (actas.Count == 0)
            {
                mensajeInformativo =
                    "No se encontraron actas con el criterio indicado.";
            }
        }
        catch (Exception ex)
        {
            mensajeError =
                $"No se pudo realizar la búsqueda: {ex.Message}";
            actas = [];
        }
        finally
        {
            cronometro.Stop();
            tiempoMilisegundos =
                cronometro.Elapsed.TotalMilliseconds;
            cargando = false;
        }
    }

    private async Task LimpiarAsync()
    {
        numeroBuscado = string.Empty;
        dniBuscado = string.Empty;
        mensajeError = null;
        mensajeInformativo = null;

        await CargarTodosAsync();
    }

    private async Task CargarTodosAsync()
    {
        cargando = true;
        mensajeError = null;
        mensajeInformativo = null;

        var cronometro = Stopwatch.StartNew();

        try
        {
            actas = await ActaService.ListarAsync();
        }
        catch (Exception ex)
        {
            mensajeError =
                $"No se pudieron cargar las actas: {ex.Message}";
            actas = [];
        }
        finally
        {
            cronometro.Stop();
            tiempoMilisegundos =
                cronometro.Elapsed.TotalMilliseconds;
            cargando = false;
        }
    }
    private void SolicitarAnulacion(long id)
    {
        idPendienteAnular = id;
        mensajeError = null;
        mensajeInformativo =
            "Confirme si realmente desea anular esta acta.";
    }

    private void CancelarAnulacion()
    {
        idPendienteAnular = null;
        mensajeInformativo = null;
    }

    private async Task ConfirmarAnulacionAsync(long id)
    {
        cargando = true;
        mensajeError = null;
        mensajeInformativo = null;

        try
        {
            var anulada = await ActaService.AnularAsync(id);

            await CargarTodosAsync();

            mensajeInformativo = anulada
                ? "El acta fue anulada correctamente."
                : "El acta ya estaba anulada o no existe.";
        }
        catch (Exception ex)
        {
            mensajeError =
                $"No se pudo anular el acta: {ex.Message}";
        }
        finally
        {
            idPendienteAnular = null;
            cargando = false;
        }
    }
}
