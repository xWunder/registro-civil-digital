@page "/actas"
@using System.Diagnostics
@using RegistroCivil.Web.Models
@using RegistroCivil.Web.Services
@inject ActaNacimientoService ActaService

<PageTitle>Búsqueda de actas</PageTitle>
<OrigenDatos Archivo="@EsArchivo" />

<div class="page-heading">
    <span class="eyebrow">Consulta de registros</span>
    <h1>Búsqueda de actas</h1>
    <p>Localice un acta de nacimiento mediante uno de los criterios disponibles.</p>
</div>

<div class="card filter-panel mb-4">
    <div class="card-body">
        <h5 class="card-title">Criterios de búsqueda</h5>

        <div class="row g-3">
            <div class="col-md-5">
                <label class="form-label" for="buscar-numero">Número de acta</label>
                <input id="buscar-numero" class="form-control"
                       placeholder="Ejemplo: ACT-2026-000001"
                       @bind="numeroBuscado"
                       @bind:event="oninput" />
            </div>

            <div class="col-md-4">
                <label class="form-label" for="buscar-dni">DNI del inscrito</label>
                <input id="buscar-dni" class="form-control"
                       placeholder="8 dígitos"
                       maxlength="8"
                       @bind="dniBuscado"
                       @bind:event="oninput" />
            </div>

            <div class="col-md-3 d-flex align-items-end gap-2">
                <button type="button"
                        class="btn btn-primary"
                        disabled="@cargando"
                        @onclick="BuscarAsync">
                    Buscar
                </button>

                <button type="button"
                        class="btn btn-outline-secondary"
                        disabled="@cargando"
                        @onclick="LimpiarAsync">
                    Limpiar
                </button>
            </div>
        </div>
    </div>
</div>

@if (!string.IsNullOrWhiteSpace(mensajeError))
{
    <div class="alert alert-danger">@mensajeError</div>
}

@if (!string.IsNullOrWhiteSpace(mensajeInformativo))
{
    <div class="alert alert-info">@mensajeInformativo</div>
}

@if (cargando)
{
    <p>Cargando actas...</p>
}
else
{
    <div class="results-summary">
        <div>
            <span>Resultados</span>
            @if (busquedaActiva)
            {
                <strong>@actas.Count @(actas.Count == 1 ? "registro encontrado" : "registros encontrados")</strong>
            }
            else
            {
                <strong>
                    Mostrando @RegistroInicial-@RegistroFinal de
                    @totalRegistros registros
                </strong>
            }
        </div>

        <div class="d-flex align-items-center gap-3 flex-wrap">
            @if (!busquedaActiva && totalRegistros > 0)
            {
                <label class="d-flex align-items-center gap-2 mb-0">
                    <span class="text-nowrap">Por página</span>
                    <select class="form-select form-select-sm"
                            style="width: auto"
                            value="@tamanoPagina"
                            disabled="@cargando"
                            @onchange="CambiarTamanoPaginaAsync">
                        <option value="25">25</option>
                        <option value="50">50</option>
                        <option value="100">100</option>
                        <option value="250">250</option>
                        <option value="500">500</option>
                    </select>
                </label>
            }

            @if (tiempoMilisegundos.HasValue)
            {
                <span class="badge bg-primary text-white">
                    Tiempo: @tiempoMilisegundos.Value.ToString("F2") ms
                </span>
            }
        </div>
    </div>

    @if (actas.Count > 0)
    {
        <div class="table-responsive data-table-shell">
            <table class="table table-striped table-hover">
                <thead>
                    <tr>
                        <th>Número de acta</th>
                        <th>DNI</th>
                        <th>Apellidos y nombres</th>
                        <th>Fecha de nacimiento</th>
                        <th>Lugar</th>
                        <th>Estado</th>
                        <th>Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var acta in actas)
                    {
                        <tr>
                            <td>@acta.NumeroActa</td>
                            <td>@(acta.DniInscrito ?? "Sin DNI")</td>
                            <td>
                                @acta.ApellidoPaterno
                                @acta.ApellidoMaterno,
                                @acta.Nombres
                            </td>
                            <td>
                                @acta.FechaNacimiento.ToString("dd/MM/yyyy")
                            </td>
                            <td>@acta.LugarNacimiento</td>
                            <td>
                                @if (acta.Estado == 1)
                                {
                                    <span class="badge bg-success">
                                        Activa
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">
                                        Anulada
                                    </span>
                                }
                            </td>
                            <td class="text-nowrap">
                                @if (acta.Estado == 1)
                                {
                                    <a class="btn btn-sm btn-outline-primary me-1"
                                       href="@($"/actas/editar/{Uri.EscapeDataString(acta.NumeroActa)}{Sufijo}")">
                                        Editar
                                    </a>

                                    @if (idPendienteAnular == acta.Id)
                                    {
                                        <button class="btn btn-sm btn-danger me-1"
                                                @onclick="() => ConfirmarAnulacionAsync(acta.Id)">
                                            Confirmar
                                        </button>

                                        <button class="btn btn-sm btn-secondary"
                                                @onclick="CancelarAnulacion">
                                            Cancelar
                                        </button>
                                    }
                                    else
                                    {
                                        <button class="btn btn-sm btn-outline-danger"
                                                @onclick="() => SolicitarAnulacion(acta.Id)">
                                            Anular
                                        </button>
                                    }
                                }
                                else
                                {
                                    <span class="text-muted">Sin acciones</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        @if (!busquedaActiva && totalPaginas > 1)
        {
            <nav class="d-flex justify-content-between align-items-center flex-wrap gap-3 mt-3"
                 aria-label="Paginación de actas">
                <span class="text-muted">
                    Página @paginaActual de @totalPaginas
                </span>

                <ul class="pagination mb-0"
                    style="max-width: 100%; overflow-x: auto">
                    <li class="page-item @(paginaActual == 1 ? "disabled" : null)">
                        <button class="page-link"
                                disabled="@(paginaActual == 1 || cargando)"
                                @onclick="() => IrAPaginaAsync(1)">
                            Primera
                        </button>
                    </li>
                    <li class="page-item @(paginaActual == 1 ? "disabled" : null)">
                        <button class="page-link"
                                aria-label="Página anterior"
                                disabled="@(paginaActual == 1 || cargando)"
                                @onclick="() => IrAPaginaAsync(paginaActual - 1)">
                            ‹
                        </button>
                    </li>

                    @foreach (var pagina in PaginasVisibles)
                    {
                        <li class="page-item @(pagina == paginaActual ? "active" : null)">
                            <button class="page-link"
                                    aria-current="@(pagina == paginaActual ? "page" : null)"
                                    disabled="@cargando"
                                    @onclick="() => IrAPaginaAsync(pagina)">
                                @pagina
                            </button>
                        </li>
                    }

                    <li class="page-item @(paginaActual == totalPaginas ? "disabled" : null)">
                        <button class="page-link"
                                aria-label="Página siguiente"
                                disabled="@(paginaActual == totalPaginas || cargando)"
                                @onclick="() => IrAPaginaAsync(paginaActual + 1)">
                            ›
                        </button>
                    </li>
                    <li class="page-item @(paginaActual == totalPaginas ? "disabled" : null)">
                        <button class="page-link"
                                disabled="@(paginaActual == totalPaginas || cargando)"
                                @onclick="() => IrAPaginaAsync(totalPaginas)">
                            Última
                        </button>
                    </li>
                </ul>
            </nav>
        }
    }
}

@code {
    [SupplyParameterFromQuery(Name = "origen")] public string? Origen { get; set; }
    private bool EsArchivo => Origen == "archivo";
    private string Sufijo => EsArchivo ? "?origen=archivo" : "";
    private List<ActaNacimiento> actas = [];
    private string numeroBuscado = string.Empty;
    private string dniBuscado = string.Empty;
    private string? mensajeError;
    private string? mensajeInformativo;
    private double? tiempoMilisegundos;
    private bool cargando = true;
    private long? idPendienteAnular;
    private bool busquedaActiva;
    private int paginaActual = 1;
    private int tamanoPagina = 50;
    private long totalRegistros;

    private int totalPaginas => totalRegistros == 0
        ? 1
        : (int)Math.Ceiling(totalRegistros / (double)tamanoPagina);

    private long RegistroInicial => totalRegistros == 0
        ? 0
        : ((long)(paginaActual - 1) * tamanoPagina) + 1;

    private long RegistroFinal => Math.Min(
        (long)paginaActual * tamanoPagina,
        totalRegistros);

    private IEnumerable<int> PaginasVisibles
    {
        get
        {
            var inicio = Math.Max(1, paginaActual - 2);
            var fin = Math.Min(totalPaginas, inicio + 4);
            inicio = Math.Max(1, fin - 4);

            return Enumerable.Range(inicio, fin - inicio + 1);
        }
    }

    protected override async Task OnParametersSetAsync()
    {
        await CargarTodosAsync();
    }

    private async Task BuscarAsync()
    {
        mensajeError = null;
        mensajeInformativo = null;
        tiempoMilisegundos = null;
        actas = [];
        busquedaActiva = true;

        var numero = numeroBuscado.Trim();
        var dni = dniBuscado.Trim();

        if (string.IsNullOrWhiteSpace(numero) &&
            string.IsNullOrWhiteSpace(dni))
        {
            mensajeError =
                "Ingrese un número de acta o un DNI para buscar.";
            return;
        }

        if (!string.IsNullOrWhiteSpace(numero) &&
            !string.IsNullOrWhiteSpace(dni))
        {
            mensajeError =
                "Utilice solamente un criterio de búsqueda a la vez.";
            return;
        }

        if (!string.IsNullOrWhiteSpace(dni) &&
            (dni.Length != 8 || !dni.All(c => c is >= '0' and <= '9')))
        {
            mensajeError = "El DNI debe contener exactamente 8 dígitos.";
            return;
        }

        cargando = true;
        var cronometro = Stopwatch.StartNew();

        try
        {
            if (!string.IsNullOrWhiteSpace(numero))
            {
                var acta =
                    await ActaService.BuscarPorNumeroAsync(numero, EsArchivo);

                actas = acta is null ? [] : [acta];
            }
            else
            {
                actas = await ActaService.BuscarPorDniAsync(dni, EsArchivo);
            }

            if (actas.Count == 0)
            {
                mensajeInformativo =
                    "No se encontraron actas con el criterio indicado.";
            }
        }
        catch (Exception ex)
        {
            mensajeError =
                $"No se pudo realizar la búsqueda: {ex.Message}";
            actas = [];
        }
        finally
        {
            cronometro.Stop();
            tiempoMilisegundos =
                cronometro.Elapsed.TotalMilliseconds;
            cargando = false;
        }
    }

    private async Task LimpiarAsync()
    {
        numeroBuscado = string.Empty;
        dniBuscado = string.Empty;
        mensajeError = null;
        mensajeInformativo = null;
        busquedaActiva = false;
        paginaActual = 1;

        await CargarPaginaAsync();
    }

    private async Task CargarTodosAsync()
    {
        busquedaActiva = false;
        paginaActual = 1;
        await CargarPaginaAsync();
    }

    private async Task CargarPaginaAsync()
    {
        cargando = true;
        mensajeError = null;
        mensajeInformativo = null;

        var cronometro = Stopwatch.StartNew();

        try
        {
            var resultado = await ActaService.ListarPaginadoAsync(
                paginaActual, tamanoPagina, EsArchivo);

            actas = resultado.Actas;
            totalRegistros = resultado.TotalRegistros;

            if (paginaActual > totalPaginas)
            {
                paginaActual = totalPaginas;
                resultado = await ActaService.ListarPaginadoAsync(
                    paginaActual, tamanoPagina, EsArchivo);
                actas = resultado.Actas;
                totalRegistros = resultado.TotalRegistros;
            }
        }
        catch (Exception ex)
        {
            mensajeError =
                $"No se pudieron cargar las actas: {ex.Message}";
            actas = [];
            totalRegistros = 0;
        }
        finally
        {
            cronometro.Stop();
            tiempoMilisegundos =
                cronometro.Elapsed.TotalMilliseconds;
            cargando = false;
        }
    }

    private async Task IrAPaginaAsync(int pagina)
    {
        if (cargando || pagina < 1 || pagina > totalPaginas ||
            pagina == paginaActual)
        {
            return;
        }

        paginaActual = pagina;
        await CargarPaginaAsync();
    }

    private async Task CambiarTamanoPaginaAsync(ChangeEventArgs args)
    {
        if (!int.TryParse(args.Value?.ToString(), out var nuevoTamano) ||
            nuevoTamano is < 1 or > 500)
        {
            return;
        }

        tamanoPagina = nuevoTamano;
        paginaActual = 1;
        await CargarPaginaAsync();
    }

    private void SolicitarAnulacion(long id)
    {
        idPendienteAnular = id;
        mensajeError = null;
        mensajeInformativo =
            "Confirme si realmente desea anular esta acta.";
    }

    private void CancelarAnulacion()
    {
        idPendienteAnular = null;
        mensajeInformativo = null;
    }

    private async Task ConfirmarAnulacionAsync(long id)
    {
        cargando = true;
        mensajeError = null;
        mensajeInformativo = null;

        try
        {
            var anulada = await ActaService.AnularAsync(id, EsArchivo);

            if (busquedaActiva)
            {
                await BuscarAsync();
            }
            else
            {
                await CargarPaginaAsync();
            }

            mensajeInformativo = anulada
                ? "El acta fue anulada correctamente."
                : "El acta ya estaba anulada o no existe.";
        }
        catch (Exception ex)
        {
            mensajeError =
                $"No se pudo anular el acta: {ex.Message}";
        }
        finally
        {
            idPendienteAnular = null;
            cargando = false;
        }
    }
}
