    <Compile Include="../RegistroCivil.Web/FileStorage/*.cs" Link="FileStorage/%(Filename)%(Extension)" />
    <Compile Include="../RegistroCivil.Web/Models/ActaNacimiento.cs" Link="Models/ActaNacimiento.cs" />
  </ItemGroup>
</Project>
